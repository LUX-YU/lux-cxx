set(stage_build "@CMAKE_BINARY_DIR@/install-consumer/stage-build")
set(stage_prefix "@CMAKE_BINARY_DIR@/install-consumer/prefix")
set(consumer_build "@CMAKE_BINARY_DIR@/install-consumer/consumer-build")
set(stage_prefix_path "@CMAKE_PREFIX_PATH@")
string(REPLACE ";" "\\;" stage_prefix_path "${stage_prefix_path}")

file(REMOVE_RECURSE "${stage_build}" "${stage_prefix}" "${consumer_build}")

set(stage_configure
    -S "@CMAKE_SOURCE_DIR@"
    -B "${stage_build}"
    -G "@CMAKE_GENERATOR@"
    "-DCMAKE_CXX_COMPILER=@CMAKE_CXX_COMPILER@"
    "-DCMAKE_INSTALL_PREFIX=${stage_prefix}"
    "-DCMAKE_CXX_STANDARD=@CMAKE_CXX_STANDARD@"
    "-DCMAKE_PREFIX_PATH=${stage_prefix_path}"
    -DLUX_CXX_BUILD_TESTS=OFF
    -DLUX_CXX_BUILD_INSTALL_CONSUMER_TEST=OFF
    -DENABLE_REFLECTION=OFF
)
if(NOT "@CMAKE_TOOLCHAIN_FILE@" STREQUAL "")
    list(APPEND stage_configure "-DCMAKE_TOOLCHAIN_FILE=@CMAKE_TOOLCHAIN_FILE@")
endif()
if(NOT "@CMAKE_BUILD_TYPE@" STREQUAL "")
    list(APPEND stage_configure "-DCMAKE_BUILD_TYPE=@CMAKE_BUILD_TYPE@")
endif()

execute_process(
    COMMAND "@CMAKE_COMMAND@" ${stage_configure}
    RESULT_VARIABLE result
)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "lux-cxx staging configure failed: ${result}")
endif()

execute_process(
    COMMAND "@CMAKE_COMMAND@" --build "${stage_build}" --config "@CMAKE_BUILD_TYPE@"
    RESULT_VARIABLE result
)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "lux-cxx staging build failed: ${result}")
endif()

execute_process(
    COMMAND "@CMAKE_COMMAND@" --install "${stage_build}" --config "@CMAKE_BUILD_TYPE@"
    RESULT_VARIABLE result
)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "lux-cxx staging install failed: ${result}")
endif()

set(consumer_configure
    -S "@CMAKE_SOURCE_DIR@/test/install_consumer"
    -B "${consumer_build}"
    -G "@CMAKE_GENERATOR@"
    "-DCMAKE_CXX_COMPILER=@CMAKE_CXX_COMPILER@"
    "-DCMAKE_PREFIX_PATH=${stage_prefix}"
    "-DCMAKE_CXX_STANDARD=@CMAKE_CXX_STANDARD@"
)
if(NOT "@CMAKE_TOOLCHAIN_FILE@" STREQUAL "")
    list(APPEND consumer_configure "-DCMAKE_TOOLCHAIN_FILE=@CMAKE_TOOLCHAIN_FILE@")
endif()
if(NOT "@CMAKE_BUILD_TYPE@" STREQUAL "")
    list(APPEND consumer_configure "-DCMAKE_BUILD_TYPE=@CMAKE_BUILD_TYPE@")
endif()

execute_process(
    COMMAND "@CMAKE_COMMAND@" ${consumer_configure}
    RESULT_VARIABLE result
)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "installed package consumer configure failed: ${result}")
endif()

execute_process(
    COMMAND "@CMAKE_COMMAND@" --build "${consumer_build}" --config "@CMAKE_BUILD_TYPE@"
    RESULT_VARIABLE result
)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "installed package consumer build failed: ${result}")
endif()

execute_process(
    COMMAND "@CMAKE_CTEST_COMMAND@"
        --test-dir "${consumer_build}"
        -C "@CMAKE_BUILD_TYPE@"
        --output-on-failure
    RESULT_VARIABLE result
)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "installed package consumer run failed: ${result}")
endif()
