include_guard(GLOBAL)
option(LUX_EXECUTION_TEST_NO_EXCEPTIONS "Compile local tests/examples without exceptions or RTTI" ON)
set(LUX_EXECUTION_SANITIZER "" CACHE STRING "Test sanitizer: empty, address, or thread")
set_property(CACHE LUX_EXECUTION_SANITIZER PROPERTY STRINGS "" address thread)
function(lux_execution_test_options target)
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /permissive-)
        if(LUX_EXECUTION_TEST_NO_EXCEPTIONS)
            target_compile_options(${target} PRIVATE /EHs-c- /GR-)
            target_compile_definitions(${target} PRIVATE _HAS_EXCEPTIONS=0)
        endif()
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic)
        if(LUX_EXECUTION_TEST_NO_EXCEPTIONS)
            target_compile_options(${target} PRIVATE -fno-exceptions -fno-rtti)
        endif()
        if(LUX_EXECUTION_SANITIZER STREQUAL "address")
            target_compile_options(${target} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
            target_link_options(${target} PRIVATE -fsanitize=address,undefined)
        elseif(LUX_EXECUTION_SANITIZER STREQUAL "thread")
            target_compile_options(${target} PRIVATE -fsanitize=thread -fno-omit-frame-pointer)
            target_link_options(${target} PRIVATE -fsanitize=thread)
        elseif(NOT LUX_EXECUTION_SANITIZER STREQUAL "")
            message(FATAL_ERROR "Unknown LUX_EXECUTION_SANITIZER")
        endif()
    endif()
endfunction()
